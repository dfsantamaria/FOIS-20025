    </owl:Class>
    


    <!-- http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#Environment -->

    <owl:Class rdf:about="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#Environment">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000029"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#EruptionDisposition -->

    <owl:Class rdf:about="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#EruptionDisposition">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000016"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#EruptionProcess"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#EruptionProcess -->

    <owl:Class rdf:about="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#EruptionProcess">
