    <!-- http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#ends_at_time -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#ends_at_time">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#starts_at_time -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#starts_at_time">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    </owl:DatatypeProperty>
    


    <!-- 
