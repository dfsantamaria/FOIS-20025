    </owl:Class>
    


    <!-- http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#EmployeeRole -->

    <owl:Class rdf:about="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#EmployeeRole">
