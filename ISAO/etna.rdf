    </owl:Class>
    


    <!-- http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#InactiveVulcano -->

    <owl:Class rdf:about="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#InactiveVulcano">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#Vulcano"/>
                    <owl:Class>
                        <owl:complementOf>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000196"/>
                                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#EruptionDisposition"/>
                            </owl:Restriction>
                        </owl:complementOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#Mountain -->

    <owl:Class rdf:about="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#Mountain">
        <owl:equivalentClass rdf:resource="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#q1"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#Mountain"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#PortionOfLava -->

    <owl:Class rdf:about="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#PortionOfLava">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#Vulcano -->

    <owl:Class rdf:about="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#Vulcano">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#ActiveVulcano"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#InactiveVulcano"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#Mountain"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000178"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#Cone"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#Working -->

    <owl:Class rdf:about="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#Working">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#activity"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000057"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#person"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000196"/>
                                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#EmployeeRole"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000117"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#working_task_execution"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000117"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000035"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#ends_at_time"/>
                                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                                        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#starts_at_time"/>
                                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                                        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#WorkingEnvironment -->

    <owl:Class rdf:about="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#WorkingEnvironment">
