    <!-- http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#Cone_1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#Cone_1">
        <rdf:type rdf:resource="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#Cone"/>
        <owl:differentFrom rdf:resource="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#Cone_2"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#Cone_2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#Cone_2">
        <rdf:type rdf:resource="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#Cone"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#English_language -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#English_language">
        <rdf:type rdf:resource="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#natural_language"/>
        <owl:differentFrom rdf:resource="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#Italian_language"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#Etna -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#Etna">
        <rdf:type rdf:resource="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#Vulcano"/>
        <rdf:type>
