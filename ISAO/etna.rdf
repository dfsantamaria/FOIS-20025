     -->

    


    <!-- http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#ActiveVulcano -->

    <owl:Class rdf:about="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#ActiveVulcano">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#Vulcano"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000196"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#EruptionDisposition"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#InactiveVulcano"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#Command_of_English -->

    <owl:Class rdf:about="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#Command_of_English">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#Command_of_language"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#Command_of_Italian"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#Command_of_Italian -->

    <owl:Class rdf:about="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#Command_of_Italian">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#Command_of_language"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#Command_of_language -->

    <owl:Class rdf:about="http://www.semanticweb.org/root/ontologies/2025/8/untitled-ontology-3#Command_of_language">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
    </owl:Class>
    


